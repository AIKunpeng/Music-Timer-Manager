<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景色 -->
    <Color x:Key="BgPrimaryColor">#1E1E2E</Color>
    <Color x:Key="BgSecondaryColor">#2A2A3C</Color>
    <Color x:Key="BgTertiaryColor">#34344A</Color>
    <Color x:Key="BgCardColor">#2D2D40</Color>
    <Color x:Key="BgElevatedColor">#3A3A50</Color>

    <SolidColorBrush x:Key="BgPrimary" Color="{StaticResource BgPrimaryColor}"/>
    <SolidColorBrush x:Key="BgSecondary" Color="{StaticResource BgSecondaryColor}"/>
    <SolidColorBrush x:Key="BgTertiary" Color="{StaticResource BgTertiaryColor}"/>
    <SolidColorBrush x:Key="BgCard" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgElevated" Color="{StaticResource BgElevatedColor}"/>
    <SolidColorBrush x:Key="BgHover" Color="#3F3F58"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#C8C8D4"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#8888A0"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#5C5C72"/>

    <!-- 主题色 -->
    <Color x:Key="AccentColor">#6C5CE7</Color>
    <Color x:Key="AccentLightColor">#8E7CF3</Color>
    <Color x:Key="AccentLighterColor">#A29BFE</Color>

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLight" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentLighter" Color="{StaticResource AccentLighterColor}"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentLighterColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientSoft" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6C5CE7" Offset="0"/>
        <GradientStop Color="#8E7CF3" Offset="0.5"/>
        <GradientStop Color="#A29BFE" Offset="1"/>
    </LinearGradientBrush>

    <!-- 功能色 -->
    <SolidColorBrush x:Key="Success" Color="#4CAF50"/>
    <SolidColorBrush x:Key="Danger" Color="#FF5252"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB300"/>
    <SolidColorBrush x:Key="Info" Color="#6C5CE7"/>

    <!-- 边框 -->
    <SolidColorBrush x:Key="BorderColor" Color="#3A3A52"/>
    <SolidColorBrush x:Key="BorderHover" Color="#5C5C7A"/>

    <!-- 阴影 -->
    <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.4" BlurRadius="16" ShadowDepth="0"/>
    <DropShadowEffect x:Key="ElevatedShadow" Color="#000000" Opacity="0.5" BlurRadius="24" ShadowDepth="4"/>

</ResourceDictionary>
