<Window x:Class="MusicScheduler.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Height="420" Width="500"
        Style="{StaticResource DarkWindowStyle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center">
            <Border Width="84" Height="84" CornerRadius="42" Background="{StaticResource AccentGradient}">
                <Border.Effect>
                    <DropShadowEffect Color="#6C5CE7" Opacity="0.5" BlurRadius="24" ShadowDepth="0"/>
                </Border.Effect>
                <TextBlock Text="♪" FontSize="44" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="音乐定时管家" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock Text="版本 1.0.0" FontSize="12" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,28,0,0">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="功能特性" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentLighter}" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}" LineHeight="22">
                        <Run Text="· 支持 MP3 / AAC / FLAC 等常见音频格式"/>
                        <LineBreak/>
                        <Run Text="· 秒级精度的多任务定时播放（自研调度引擎）"/>
                        <LineBreak/>
                        <Run Text="· 任务时间冲突自动检测与保护"/>
                        <LineBreak/>
                        <Run Text="· 不依赖 Windows 计划任务程序"/>
                        <LineBreak/>
                        <Run Text="· 开机自启 + 系统托盘常驻"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0" Background="#246C5CE7">
                <StackPanel>
                    <TextBlock Text="版权声明" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentLighter}" Margin="0,0,0,6"/>
                    <TextBlock Text="版权所有 © 深圳安信联创科技有限公司" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="All rights reserved. 未经授权禁止复制、传播或商业使用。" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Button Grid.Row="2" Style="{StaticResource AccentButton}" Content="确定" Width="120" HorizontalAlignment="Center" Margin="0,18,0,0" Click="Close_Click"/>
    </Grid>
</Window>
