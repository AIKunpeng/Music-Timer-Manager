<Window x:Class="MusicScheduler.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:conv="clr-namespace:MusicScheduler.Converters"
        xmlns:vm="clr-namespace:MusicScheduler.ViewModels"
        Title="音乐定时管家"
        Height="720" Width="1180"
        MinHeight="600" MinWidth="980"
        Style="{StaticResource DarkWindowStyle}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <conv:CountToVisibilityConverter x:Key="CountToVis"/>
        <conv:StringToVisibilityConverter x:Key="StrToVis"/>
        <conv:SecondsToMmSsConverter x:Key="SecToStr"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部导航栏 -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondary}" Padding="24,16" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="♪" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="音乐定时管家" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="智能定时 · 精准播放 · 全自动调度" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BgElevated}" CornerRadius="8" Padding="14,6">
                        <TextBlock Text="{Binding CurrentTimeText}" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AccentLighter}" FontFamily="Consolas, Microsoft YaHei UI"/>
                    </Border>
                    <Button Content="⚙ 设置" Style="{StaticResource BaseButton}" Margin="12,0,0,0" Command="{Binding OpenSettingsCommand}"/>
                    <Button Content="ⓘ 关于" Style="{StaticResource BaseButton}" Margin="8,0,0,0" Command="{Binding OpenAboutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：左侧播放器 + 右侧任务列表 -->
        <Grid Grid.Row="1" Margin="24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 播放器面板 -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,16,0" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="正在播放" FontSize="13" Foreground="{StaticResource TextTertiary}" FontWeight="Medium"/>

                    <!-- 专辑封面占位 -->
                    <Border x:Name="Cover" Grid.Row="1" Margin="0,16" CornerRadius="12" Height="220"
                            Background="{StaticResource AccentGradientSoft}">
                        <Border.Effect>
                            <DropShadowEffect x:Name="CoverShadow" Color="#6C5CE7" Opacity="0.45" BlurRadius="32" ShadowDepth="0"/>
                        </Border.Effect>
                        <Grid>
                            <TextBlock Text="♪" FontSize="96" Foreground="White" Opacity="0.85"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 歌曲信息 -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Playback.CurrentTitle}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Playback.CurrentTaskName}" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 进度条 + 播放控制 + 音量 -->
                    <StackPanel Grid.Row="3" Margin="0,20,0,0">
                        <Grid>
                            <Slider Style="{StaticResource DarkSlider}" x:Name="ProgressSlider"
                                    AutomationProperties.Name="播放进度条"
                                    Minimum="0"
                                    Maximum="{Binding Playback.CurrentDurationSeconds, Mode=OneWay}"
                                    Value="{Binding Playback.CurrentPositionSeconds, Mode=OneWay}"
                                    IsEnabled="{Binding Playback.CanSeek}"
                                    PreviewMouseLeftButtonDown="ProgressSlider_DragStart"
                                    PreviewMouseLeftButtonUp="ProgressSlider_DragEnd"
                                    Thumb.DragDelta="ProgressSlider_DragDelta"
                                    LostMouseCapture="ProgressSlider_LostCapture"
                                    ToolTip="拖动或点击快进/后退"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="{Binding Playback.CurrentPositionSeconds, Converter={StaticResource SecToStr}}"
                                       FontSize="11" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding Playback.CurrentDurationSeconds, Converter={StaticResource SecToStr}}"
                                       FontSize="11" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Right"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <Button Style="{StaticResource IconButton}" Command="{Binding Playback.PreviousCommand}" ToolTip="上一首">
                                <TextBlock Text="⏮" FontSize="18" Foreground="{StaticResource TextPrimary}"/>
                            </Button>
                            <Button x:Name="PlayPauseButton" AutomationProperties.AutomationId="PlayPauseButton" Style="{StaticResource PrimaryPlayButton}" Margin="14,0" Command="{Binding Playback.TogglePauseCommand}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <ToolTip.Style>
                                            <Style TargetType="ToolTip">
                                                <Setter Property="Content" Value="暂停"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Playback.IsPaused}" Value="True">
                                                        <Setter Property="Content" Value="继续播放"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Playback.IsPlaying}" Value="False"/>
                                                            <Condition Binding="{Binding Playback.IsPaused}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Content" Value="播放"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToolTip.Style>
                                    </ToolTip>
                                </Button.ToolTip>
                                <TextBlock FontSize="22" Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="⏸"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Playback.IsPlaying}" Value="False">
                                                    <Setter Property="Text" Value="▶"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding Playback.NextCommand}" ToolTip="下一首">
                                <TextBlock Text="⏭" FontSize="18" Foreground="{StaticResource TextPrimary}"/>
                            </Button>
                            <Button AutomationProperties.AutomationId="StopButton" Style="{StaticResource IconButton}" Margin="14,0,0,0" Command="{Binding StopPlaybackCommand}" ToolTip="停止播放（再点播放将从头开始）">
                                <TextBlock Text="⏹" FontSize="18" Foreground="{StaticResource Danger}"/>
                            </Button>
                        </StackPanel>

                        <!-- 播放状态：正在播放 / 已暂停 / 已停止 -->
                        <TextBlock AutomationProperties.AutomationId="PlaybackStatusText" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="已停止"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Playback.IsPlaying}" Value="True">
                                            <Setter Property="Text" Value="正在播放"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentLighter}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Playback.IsPaused}" Value="True">
                                            <Setter Property="Text" Value="已暂停"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔊" FontSize="13" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Style="{StaticResource DarkSlider}" Margin="8,0"
                                    Minimum="0" Maximum="100"
                                    Value="{Binding Playback.VolumePercent, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Playback.VolumePercent, StringFormat={}{0:0}}"
                                       FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" MinWidth="32" TextAlignment="Right"/>
                        </Grid>

                        <!-- 均衡器（10 段） -->
                        <Border Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,16,0,0" Background="#262639">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎚 10 段均衡器" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentLighter}"/>
                                        <TextBlock Text="  ·  " Foreground="{StaticResource TextTertiary}" FontSize="11"/>
                                        <TextBlock Text="{Binding Equalizer.Preset}" FontSize="11" Foreground="{StaticResource TextTertiary}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" SelectedIndex="0" MinWidth="100" x:Name="EqPresetCombo"
                                              SelectionChanged="EqPreset_Changed"
                                              Background="{StaticResource BgElevated}" Foreground="Black" BorderBrush="{StaticResource BorderColor}">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Foreground" Value="Black"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Foreground" Value="Black"/>
                                                    </Trigger>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter Property="Foreground" Value="Black"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                        <ComboBoxItem Content="平坦"/>
                                        <ComboBoxItem Content="流行"/>
                                        <ComboBoxItem Content="古典"/>
                                        <ComboBoxItem Content="摇滚"/>
                                        <ComboBoxItem Content="人声"/>
                                        <ComboBoxItem Content="电子"/>
                                        <ComboBoxItem Content="低音增强"/>
                                        <ComboBoxItem Content="高音增强"/>
                                    </ComboBox>
                                </Grid>
                                <ItemsControl x:Name="EqBands" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="10"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center" Margin="2,0">
                                                <TextBlock Text="{Binding DbText}" FontSize="9" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                <Slider Orientation="Vertical" Height="100"
                                                        Minimum="-12" Maximum="12" TickFrequency="3" IsMoveToPointEnabled="True"
                                                        Value="{Binding Value, Mode=TwoWay}"
                                                        Background="{StaticResource BgPrimary}" Foreground="{StaticResource AccentLighter}"
                                                        HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 任务列表 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="0" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="20,16,20,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="播放任务" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding NextTaskText}" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource BaseButton}" ToolTip="导入任务" Command="{Binding ImportTasksCommand}" Content="⤓ 导入"/>
                            <Button Style="{StaticResource BaseButton}" ToolTip="导出任务" Command="{Binding ExportTasksCommand}" Content="⤒ 导出" Margin="8,0,0,0"/>
                            <Button Style="{StaticResource AccentButton}" Command="{Binding NewTaskCommand}" Content="+ 新建任务" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,20">
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TaskCard" Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="16,14"
                                            MouseEnter="TaskCard_MouseEnter" MouseLeave="TaskCard_MouseLeave"
                                            Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                                    <Border Background="{StaticResource BgElevated}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RepeatDisplay}" FontSize="10" Foreground="{StaticResource AccentLighter}"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <TextBlock Text="⏱" FontSize="12" Foreground="{StaticResource TextTertiary}"/>
                                                    <TextBlock Text="{Binding TimeRangeDisplay}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="6,0,0,0" FontFamily="Consolas, Microsoft YaHei UI"/>
                                                    <TextBlock Text=" · " FontSize="12" Foreground="{StaticResource TextTertiary}"/>
                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding EqPresetDisplay}" FontSize="12" Foreground="{StaticResource AccentLighter}" Margin="8,0,0,0" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" ToolTip="启用/停用"/>
                                                <Button Style="{StaticResource ListItemButton}" Margin="10,0,0,0" Content="▶ 立即" Command="{Binding DataContext.RunNowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource ListItemButton}" Margin="6,0,0,0" Content="编辑" Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource ListItemButton}" Margin="6,0,0,0" Content="复制" Command="{Binding DataContext.DuplicateTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="复制任务并打开编辑"/>
                                                <Button Style="{StaticResource ListItemButton}" Margin="6,0,0,0" Content="删除" Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1" Text="还没有任务，点击右上角“+ 新建任务”开始使用"
                               FontSize="13" Foreground="{StaticResource TextTertiary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                             Fill="{StaticResource TextTertiary}" Visibility="Collapsed"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="© 2026 音乐定时管家   版权所有 深圳安信联创科技有限公司" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 托盘图标（由代码挂载） -->
        <tb:TaskbarIcon x:Name="TrayIcon" Grid.Row="0" Visibility="Collapsed"
                        ToolTipText="音乐定时管家" />
    </Grid>
</Window>
